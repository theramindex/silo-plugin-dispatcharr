  "presentation": {
    "display_name": "Dispatcharr for Silo",
    "summary": "Live TV, guide, sports, and DVR plugin for Silo, backed by Dispatcharr.",
    "description_markdown": "Dispatcharr plugin for Silo. It presents Live TV, the TV guide, sports, events, VOD, series, and Dispatcharr DVR inside Silo. Playback and recordings stay on the configured Dispatcharr, Xtream Codes, or M3U/XMLTV source.",
    "setup_markdown": "1. Install the plugin in Silo Server.\n2. Open Dispatcharr Admin and choose Dispatcharr Direct, Xtream Codes, or M3U/XMLTV.\n3. For Dispatcharr Direct, use an Admin API key from System > Users > Edit User > API & XC.\n4. Enable the catalog sync scheduled task after install.",
    "homepage_url": "https://github.com/theramindex/silo-plugin-dispatcharr",
    "source_url": "https://github.com/theramindex/silo-plugin-dispatcharr",
    "support_url": "https://github.com/theramindex/silo-plugin-dispatcharr/issues",
    "changelog_url": "https://github.com/theramindex/silo-plugin-dispatcharr/releases",
    "publisher_name": "Ramindex",
