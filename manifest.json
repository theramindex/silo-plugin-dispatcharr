      "type": "scheduled_task.v1",
      "id": "dispatcharr-sync",
      "display_name": "Dispatcharr catalog sync",
      "description": "Syncs Live TV channels, guide, VOD, and series from the configured source."
    },
    {
      "type": "scheduled_task.v1",
      "id": "dispatcharr-refresh-channels",
      "display_name": "Dispatcharr channel refresh",
      "description": "Refreshes the Live TV channel lineup without rebuilding the full catalog."
    },
    {
      "type": "scheduled_task.v1",
      "id": "dispatcharr-refresh-epg",
      "display_name": "Dispatcharr guide refresh",
      "description": "Refreshes guide/EPG data for the current Live TV lineup."
    },
